@inherits LayoutComponentBase
@inject SettingsService Settings
@inject RecognitionStateService RecState
@inject NavigationManager Nav

<MudThemeProvider Theme="@_theme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-shell">
    <MudLayout>
        <MudAppBar Elevation="0" Class="app-bar" Dense="false">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@DrawerToggle" aria-label="Меню" />
            <div class="brand ms-2">
                <span class="brand-mark" aria-hidden="true"></span>
                <div class="brand-text">
                    <MudText Typo="Typo.h6" Class="brand-title mb-0">Nomeroff</MudText>
                    <MudText Typo="Typo.caption" Class="brand-sub">YOLO · GPS · Interbase</MudText>
                </div>
            </div>
            <MudSpacer />
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="status-chip d-none d-sm-flex"
                     Color="@(RecState.IsRunning ? Color.Success : Color.Default)">
                @(RecState.IsRunning ? "Съёмка идёт" : "Ожидание")
            </MudChip>
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Class="app-drawer" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md">
            <div class="drawer-hero pa-4">
                <MudText Typo="Typo.subtitle1" Class="mb-1">Панель</MudText>
            </div>
            <NavMenu />
        </MudDrawer>

        <MudMainContent Class="app-main pt-16 pa-4 pa-md-6">
            <div class="page-canvas">
                @Body
            </div>
            <RecognitionControlPanel />
        </MudMainContent>
    </MudLayout>
</div>

@code {
    private bool _drawerOpen = true;
    private MudTheme? _theme;
    private static bool _autoStartAlreadyTriggered;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _theme = new MudTheme
        {
            PaletteLight = _lightPalette,
            Typography = new Typography
            {
                Default = new DefaultTypography
                {
                    FontFamily = new[] { "Manrope", "Segoe UI", "sans-serif" }
                },
                H4 = new H4Typography { FontFamily = new[] { "Fraunces", "Georgia", "serif" }, FontWeight = "600" },
                H5 = new H5Typography { FontFamily = new[] { "Fraunces", "Georgia", "serif" }, FontWeight = "600" },
                H6 = new H6Typography { FontFamily = new[] { "Fraunces", "Georgia", "serif" }, FontWeight = "600" },
            },
            LayoutProperties = new LayoutProperties
            {
                DefaultBorderRadius = "14px"
            }
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_autoStartAlreadyTriggered)
        {
            _autoStartAlreadyTriggered = true;
            try
            {
                if (await Settings.GetAutoStartAsync())
                {
                    await RecState.RequestStartAsync();
                    Nav.NavigateTo("/", forceLoad: false);
                }
            }
            catch { }
        }
    }

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private readonly PaletteLight _lightPalette = new()
    {
        Primary = "#0F6B5C",
        Secondary = "#C45C26",
        AppbarBackground = "rgba(247, 243, 235, 0.92)",
        AppbarText = "#1C2A26",
        Background = "#F3EDE3",
        Surface = "#FFFBF5",
        DrawerBackground = "#F7F3EB",
        DrawerText = "#24332E",
        DrawerIcon = "#3D534B",
        TextPrimary = "#1C2A26",
        TextSecondary = "#5C6B64",
        ActionDefault = "#3D534B",
        LinesDefault = "#E4DDD0",
        Divider = "#E0D8C8",
        TableLines = "#E4DDD0",
        Success = "#2F8F5B",
        Warning = "#C9862A",
        Error = "#C1453D",
        Info = "#2F6F8F",
    };
}
