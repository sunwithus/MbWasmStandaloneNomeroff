@page "/file"
@page "/"
@inject RecordsService Records
@inject NomeroffService Nomeroff
@inject SettingsService SettingsSvc
@inject VideoResultProcessor VideoProcessor
@inject ISnackbar Snackbar
@inject ILogger<File> Logger
@inject IConfiguration Config
@using MbWebApp.Services

<PageTitle>Файл - изображение или видео</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Загрузка файла</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    Изображение — сразу; видео — ffmpeg + OCR. Для папки целиком см. раздел «Папка».
</MudText>

<MudPaper Class="pa-4" Outlined="true">
    <MudStack Spacing="2">
        <InputFile OnChange="OnFileSelected" accept="image/*,video/*" disabled="@_processing">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Upload" Style="cursor:pointer;">
                Выбрать файл (фото или видео)
            </MudButton>
        </InputFile>

        @if (_selectedVideoFile != null)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                Видео: @_selectedVideoName (@FormatFileSize(_selectedVideoFile.Size))
            </MudAlert>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudNumericField T="int" @bind-Value="_videoIntervalSec" Label="Интервал (сек)" Min="1" Max="60" Style="width:120px;" Disabled="@_processing" />
                <MudCheckBox T="bool" @bind-Value="_saveVideoToDb" Label="Сохранять в БД" Color="Color.Primary" Disabled="@_processing" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_processing" OnClick="ProcessVideoOnServer">
                    Распознать номера по видео
                </MudButton>
            </MudStack>
            @if (_processing)
            {
                <MudPaper Class="pa-3 mt-2" Outlined="true" Style="background:var(--mud-palette-background-gray);">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">@_progressTitle</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">@_progressMessage</MudText>
                    @if (_progressTotal > 0)
                    {
                        <MudText Typo="Typo.caption" Class="mb-1">
                            Кадр @_progressCurrent из @_progressTotal
                            @if (_progressPercent > 0) { <text> · @_progressPercent%</text> }
                        </MudText>
                    }
                    else if (_progressPercent > 0)
                    {
                        <MudText Typo="Typo.caption" Class="mb-1">@_progressPercent%</MudText>
                    }
                    <MudProgressLinear Color="Color.Primary"
                                       Value="@_progressPercent"
                                       Indeterminate="@(_progressPercent <= 0 && _progressTotal <= 0)"
                                       Style="height:8px;" Class="mb-3" />
                    <MudStack Spacing="1">
                        @foreach (var step in _progressSteps)
                        {
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@(step.Done ? Icons.Material.Filled.CheckCircle : step.Active ? Icons.Material.Filled.PlayCircle : Icons.Material.Filled.RadioButtonUnchecked)"
                                         Color="@(step.Done ? Color.Success : step.Active ? Color.Primary : Color.Default)"
                                         Size="Size.Small" />
                                <MudText Typo="Typo.caption" Color="@(step.Active ? Color.Primary : Color.Default)">@step.Label</MudText>
                            </MudStack>
                        }
                    </MudStack>
                </MudPaper>
            }
        }
    </MudStack>
</MudPaper>

@if (_imagePreviewUrl != null)
{
    <MudPaper Class="pa-2 mt-4" Outlined="true">
        <MudText Typo="Typo.subtitle2" Class="mb-2">Предпросмотр</MudText>
        <img src="@_imagePreviewUrl" style="max-width:100%; max-height:300px;" alt="preview" />
    </MudPaper>
}

@if (_lastResponse != null)
{
    <MudPaper Class="pa-4 mt-4" Outlined="true">
        <MudText Typo="Typo.subtitle2" GutterBottom="true">Последний результат</MudText>
        <MudText Typo="Typo.body2">@_lastResponse.Message</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">Время: @(_lastResponse.ProcessingTimeMs) мс</MudText>
        @if (_lastResponse.Plates.Count > 0)
        {
            <MudStack Row="true" Spacing="1" Class="mt-2" Style="flex-wrap:wrap;">
                @foreach (var p in _lastResponse.Plates)
                {
                    <MudChip T="string" Size="Size.Small" Color="@(p.IsInWatchlist ? Color.Error : Color.Default)">
                        @p.Plate
                        @if (p.IsInWatchlist) { <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="ms-1" /> }
                        @if (p.IsDuplicate) { <MudText Typo="Typo.caption" Color="Color.Secondary">(дубль)</MudText> }
                    </MudChip>
                }
            </MudStack>
        }
    </MudPaper>
}

@if (_videoResults.Count > 0)
{
    <MudPaper Class="pa-4 mt-4" Outlined="true">
        <MudText Typo="Typo.subtitle2" GutterBottom="true">Номера по видео</MudText>
        @if (_videoSummary is not null)
        {
            <MudText Typo="Typo.body2">
                Файл: @_selectedVideoName (@FormatFileSize(_selectedVideoFile?.Size ?? 0))
            </MudText>
            <MudText Typo="Typo.body2">
                Интервал: @_videoSummary.IntervalSec с, кадров: @_videoSummary.TotalFrames,
                с номерами: @_videoSummary.FramesWithPlates,
                всего: @_videoSummary.TotalPlates,
                уникальных: @_videoSummary.UniquePlates
            </MudText>
        }
        <MudStack Row="true" Spacing="1" Style="flex-wrap:wrap;">
            @foreach (var r in _videoResults.OrderByDescending(x => x.TimeSec).Take(50))
            {
                <MudChip T="string" Size="Size.Small" Color="@(r.IsInWatchlist ? Color.Error : Color.Default)">
                    @r.Plate @r.TimeSec.ToString("F1")с
                    @if (r.Latitude.HasValue && r.Longitude.HasValue)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary"> @r.Latitude.Value.ToString("F4"),@r.Longitude.Value.ToString("F4")</MudText>
                    }
                    @if (r.IsDuplicate) { <MudText Typo="Typo.caption" Color="Color.Secondary">-дубль</MudText> }
                </MudChip>
            }
        </MudStack>
        @if (_videoResults.Count > 50)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Показано 50 из @_videoResults.Count</MudText>
        }
    </MudPaper>
}

@code {
    private bool _processing;
    private string? _imagePreviewUrl;
    private int _videoIntervalSec = 1;
    private bool _saveVideoToDb;
    private ProcessFrameResponse? _lastResponse;
    private readonly List<VideoPlateHit> _videoResults = new();
    private readonly Dictionary<string, DateTime> _imageDedupCache = new();
    private IBrowserFile? _selectedVideoFile;
    private string _selectedVideoName = "";
    private VideoProcessSummary? _videoSummary;

    private string _progressTitle = "";
    private string _progressMessage = "";
    private int _progressPercent;
    private int _progressCurrent;
    private int _progressTotal;
    private List<ProgressStep> _progressSteps = new();

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        _selectedVideoFile = null;
        _selectedVideoName = "";
        _imagePreviewUrl = null;
        _lastResponse = null;
        _videoResults.Clear();
        _videoSummary = null;
        var contentType = file.ContentType.ToLowerInvariant();

        if (contentType.StartsWith("image/"))
        {
            _processing = true;
            StateHasChanged();
            try
            {
                await using var ms = new MemoryStream();
                await file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024).CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                _imagePreviewUrl = $"data:{contentType};base64,{base64}";
                var response = await Nomeroff.ProcessFrameAsync(base64);
                if (response != null)
                {
                    var watchlist = await SettingsSvc.GetWatchlistAsync();
                    EnrichPlates(response, watchlist, _imageDedupCache, await SettingsSvc.GetDedupIntervalSecAsync());
                    _lastResponse = response;
                    await MaybeSaveRecordsForImage(base64, response);
                    foreach (var p in response.Plates.Where(x => x.IsInWatchlist && !x.IsDuplicate))
                    {
                        _ = Nomeroff.PlayBeepAsync();
                        Snackbar.Add($"В watchlist: {p.Plate}", Severity.Warning);
                    }
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
            }
            finally
            {
                _processing = false;
                await InvokeAsync(StateHasChanged);
            }
            return;
        }

        if (contentType.StartsWith("video/"))
        {
            _selectedVideoFile = file;
            _selectedVideoName = file.Name;
            await InvokeAsync(StateHasChanged);
            return;
        }

        Snackbar.Add("Неподдерживаемый формат", Severity.Error);
    }

    private void ResetProgressUi()
    {
        _progressTitle = "Обработка видео";
        _progressMessage = "Подготовка...";
        _progressPercent = 0;
        _progressCurrent = 0;
        _progressTotal = 0;
        _progressSteps =
        [
            new ProgressStep("upload", "1. Загрузка на сервер"),
            new ProgressStep("ffmpeg", "2. Извлечение кадров (ffmpeg)"),
            new ProgressStep("ocr", "3. Распознавание номеров (OCR)"),
            new ProgressStep("finalize", "4. Обработка результатов" + (_saveVideoToDb ? " и запись в БД" : ""))
        ];
    }

    private void ApplyServerProgress(VideoProcessProgress p)
    {
        _progressMessage = string.IsNullOrWhiteSpace(p.Message) ? StageTitle(p.Stage) : p.Message;
        _progressTitle = StageTitle(p.Stage);
        if (p.Percent > 0) _progressPercent = Math.Clamp(p.Percent, 0, 100);
        if (p.Total > 0)
        {
            _progressCurrent = p.Current;
            _progressTotal = p.Total;
        }
        var map = p.Stage switch
        {
            "upload" or "save" => "upload",
            "ffmpeg" => "ffmpeg",
            "ocr" => "ocr",
            "done" => "finalize",
            _ => p.Stage
        };
        SetActiveStep(map);
    }

    private static string StageTitle(string stage) => stage switch
    {
        "upload" => "Загрузка",
        "save" => "Подготовка",
        "ffmpeg" => "Извлечение кадров",
        "ocr" => "Распознавание",
        "done" or "finalize" => "Завершение",
        _ => "Обработка видео"
    };

    private void SetActiveStep(string id)
    {
        var order = new[] { "upload", "ffmpeg", "ocr", "finalize" };
        var idx = Array.IndexOf(order, id);
        if (idx < 0) return;
        for (var i = 0; i < _progressSteps.Count; i++)
        {
            _progressSteps[i].Done = i < idx;
            _progressSteps[i].Active = i == idx;
        }
    }

    private async Task ProcessVideoOnServer()
    {
        if (_selectedVideoFile == null) return;
        var videoUrl = await SettingsSvc.GetVideoApiBaseUrlAsync();
        if (string.IsNullOrEmpty(videoUrl))
        {
            Snackbar.Add("Укажите URL Video API в настройках", Severity.Warning);
            return;
        }
        _processing = true;
        _videoResults.Clear();
        _lastResponse = null;
        _videoSummary = null;
        ResetProgressUi();
        SetActiveStep("upload");
        StateHasChanged();
        try
        {
            var interval = Math.Clamp(_videoIntervalSec, 1, 60);
            var progress = new Progress<VideoProcessProgress>(p =>
            {
                ApplyServerProgress(p);
                _ = InvokeAsync(StateHasChanged);
            });
            await using var stream = _selectedVideoFile.OpenReadStream(maxAllowedSize: 1024 * 1024 * 1024);
            var apiResponse = await Records.ProcessVideoAsync(stream, _selectedVideoFile.Name, interval, progress);
            if (apiResponse == null)
            {
                Logger.LogWarning("ProcessVideoOnServer: apiResponse=null");
                Snackbar.Add("Ошибка обработки видео. Проверьте OCR API и ffmpeg.", Severity.Error);
                return;
            }

            SetActiveStep("finalize");
            _progressTitle = "Обработка результатов";
            await InvokeAsync(StateHasChanged);

            var outcome = await VideoProcessor.ProcessAsync(new VideoResultProcessRequest
            {
                ApiResponse = apiResponse,
                SaveToDb = _saveVideoToDb,
                DedupIntervalSec = await SettingsSvc.GetDedupIntervalSecAsync(),
                SkipSaveWithoutGps = await SettingsSvc.GetSkipSaveWithoutGpsAsync(),
                Watchlist = await SettingsSvc.GetWatchlistAsync(),
                DeviceName = await SettingsSvc.GetDeviceNameAsync(),
                Source = "video_file",
                Progress = new Progress<(int current, int total, string message)>(p =>
                {
                    _progressCurrent = p.current;
                    _progressTotal = p.total;
                    _progressPercent = (int)(100.0 * p.current / Math.Max(p.total, 1));
                    _progressMessage = p.message;
                    if (p.current == 1 || p.current == p.total || p.current % 5 == 0)
                        _ = InvokeAsync(StateHasChanged);
                })
            });

            _videoResults.AddRange(outcome.Hits);
            _videoSummary = outcome.Summary;
            foreach (var alert in outcome.WatchlistAlerts)
            {
                _ = Nomeroff.PlayBeepAsync();
                Snackbar.Add($"В watchlist: {alert}", Severity.Warning);
            }
            Snackbar.Add(
                $"Кадров: {outcome.Summary.TotalFrames}, номеров: {outcome.Hits.Count}, GPS: {outcome.Summary.GpsFrames}" +
                (_saveVideoToDb ? $", в БД с GPS: {outcome.Summary.SavedWithGps}" : ""),
                Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
        finally
        {
            _processing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task MaybeSaveRecordsForImage(string screenshotBase64, ProcessFrameResponse response)
    {
        if (await SettingsSvc.GetSkipSaveWithoutGpsAsync())
            return;
        var minConf = Config.GetValue("PlateMinConfidence", 0.70);
        var timeUtc = DateTime.UtcNow.ToString("O");
        var deviceName = await SettingsSvc.GetDeviceNameAsync();
        foreach (var p in response.Plates.Where(x => !x.IsDuplicate && x.Confidence >= minConf))
        {
            var dbName = await Records.GetOrCreateCurrentDbAsync();
            var saved = await Records.SaveRecordAsync(new RecordDto
            {
                ScreenshotBase64 = screenshotBase64,
                TimeUtc = timeUtc,
                CarNumber = p.Plate,
                DeviceId = string.IsNullOrEmpty(deviceName) ? null : deviceName,
                Source = "image_file",
                Db = dbName
            });
            if (!saved) break;
        }
    }

    private static void EnrichPlates(ProcessFrameResponse response, List<string> watchlist, Dictionary<string, DateTime> dedupCache, int dedupSec)
    {
        var set = watchlist.Select(PlateAlphabet.Normalize).Where(s => !string.IsNullOrEmpty(s)).ToHashSet();
        foreach (var p in response.Plates)
        {
            var plate = PlateAlphabet.Normalize(p.Plate);
            p.Plate = plate;
            p.IsInWatchlist = set.Contains(plate);
            p.IsDuplicate = dedupCache.TryGetValue(plate, out var last) && (DateTime.UtcNow - last).TotalSeconds < dedupSec;
            dedupCache[plate] = DateTime.UtcNow;
        }
    }

    private sealed class ProgressStep
    {
        public ProgressStep(string id, string label) { Id = id; Label = label; }
        public string Id { get; }
        public string Label { get; }
        public bool Done { get; set; }
        public bool Active { get; set; }
    }
}
