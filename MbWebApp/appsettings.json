{
  // Порты ниже — источник истины. Urls / AppBaseUrl / NomeroffApiBaseUrl
  // при старте перезаписываются из Ports (см. start-app.bat).
  "Urls": "http://0.0.0.0:5555",
  "AppBaseUrl": "http://127.0.0.1:5555",          // это приложение (БД / GPS / видео API)
  "NomeroffApiBaseUrl": "http://127.0.0.1:8000",  // Python OCR
  "Ports": {
    "App": 5555,   // UI + API
    "Ocr": 8000    // nomeroff-net
  },

  // --- распознавание ---
  //
  // Конвейер коротко: ffmpeg режет ролик на кадры → каждый кадр уходит в Python
  // в нескольких вариантах (PlateVariants) → YOLO ищет рамку номера → OCR читает
  // текст → C# склеивает чтения в треки и голосует. В БД попадает не «что увидел
  // один кадр», а победитель голосования (если он достаточно повторился).
  //
  // Пороги ниже — это сито. Поднимать = меньше мусора и пропусков «на грани».
  // Опускать = больше номеров и больше фантомов (вывески, чужие куски номера).

  // Сколько кадров держать в одной порции разбора длинного ролика.
  // Это не «максимум кадров из видео»: ролик обрабатывается целиком.
  // Сейчас реальная порция на один HTTP-запрос к OCR — PlateBatchSize.
  // MaxVideoFrames остаётся в /health и как запасной лимит; 300 трогать не нужно,
  // если не упираетесь в память на очень длинных файлах.
  "MaxVideoFrames": 300,

  // YOLO: «насколько это похоже на номер», 0…1. Не путать с уверенностью текста.
  // Ниже порога рамка даже не идёт в OCR. 0.60 — рабочий баланс.
  // Выше (0.70–0.80) — тише ложные рамки (грязь, решётка), но мелкий/дальний номер
  // может не дойти до чтения. Ниже (0.45) — больше рамок и больше мусора в OCR.
  "PlateMinConfidence": 0.60,

  // То же для «шумных» проходов: вырезанная зона дороги (roi) и негатив (roi_invert).
  // Там детектор чаще цепляется за текстуру, поэтому порог выше обычного.
  // Если военные номера пропадают — сначала проверьте, что roi_invert есть в
  // PlateVariants, и только потом чуть опустите это значение (не ниже ~0.60).
  "PlateRoiMinConfidence": 0.72,

  // OCR: «насколько модель уверена в буквах», 0…1. Главный фильтр мусора.
  // Кадр может содержать рамку номера (высокий PlateMinConfidence), но текст
  // прочитан как «АВАРИЙНАЯ» / «T34CO2» — такие отсекаются здесь.
  // 0.55 — текущий рабочий. Выше (0.70) — чище БД, чаще пропуск грязного номера.
  // Ниже (0.40) — больше попаданий и больше выдуманных строк.
  "PlateOcrMinConfidence": 0.55,

  // Сколько разных кадров должны показать ОДИН И ТОТ ЖЕ текст, чтобы писать в БД.
  // Считаются не «любые чтения трека», а дословные повторы победителя
  // (иначе вывеска на борту, прочитанная каждый кадр по-разному, пролезает).
  // 2 — норма для видео: машина в кадре долю секунды, при SampleFps=5 это реально.
  // 3 — жёстче против фантомов, но одиночный проезд на краю кадра отвалится.
  // 1 — почти всё, что OCR выдал хоть раз (обычно слишком грязно).
  "PlateMinFrameHits": 2,

  // Исключение из правила «нужно 2 кадра»: один очень уверенный кадр тоже пишем.
  // Нужен для короткого проблеска (машина на краю, один удачный ракурс).
  // MinOcrConfidence=0.95 — почти «OCR сам не сомневается». Ниже 0.90 лучше
  // не ставить: тогда одиночные фантомы снова поедут в БД.
  "PlateSingleSighting": {
    "Enabled": true,
    "MinOcrConfidence": 0.95
  },

  // Сколько кадров в секунду вырезать из ролика для распознавания.
  // Это не fps самого файла: из 25–30 к/с берём каждый N-й.
  // Голосованию нужны хотя бы 2 кадра на одну машину. При 5.0 машина в кадре
  // 0.4 с уже даёт 2 пробы. 3.0 — быстрее и легче, но короткий проезд может
  // попасть в один кадр (тогда спасёт только PlateSingleSighting).
  // 8–10 — больше шансов на дальние номера, заметно тяжелее GPU/CPU.
  // Режим папки берёт своё значение из FolderWatch:SampleFps, не это.
  "SampleFps": 5.0,

  // Сколько уже вырезанных кадров отправить в Python за один запрос.
  // Больше = меньше накладных HTTP, но выше пик VRAM/RAM.
  // 8 — нормально для 8–12 ГБ. Если OCR падает с OOM — поставьте 4 или 2.
  "PlateBatchSize": 8,

  // Какие копии кадра отдать детектору/OCR. Перечислять через запятую, без пробелов.
  //   full         — кадр как есть
  //   crop         — без нижней полосы (капот + OSD), меньше ложных рамок снизу
  //   roi          — только зона дороги
  //   roi_contrast — та же зона с усиленным контрастом (грязь, тень)
  //   roi_invert   — негатив: без него военные номера почти не читаются
  // Убирать full/crop не стоит. Убрать roi_invert можно только если военных нет.
  "PlateVariants": "full,crop,roi,roi_contrast,roi_invert",

  // Декодировать видео на GPU (ffmpeg -hwaccel auto). Сам ролик так разбирается
  // быстрее; на распознавание номеров это не влияет. Нет NVIDIA / старый драйвер —
  // ffmpeg молча идёт на CPU, ничего чинить не нужно. false — всегда софт.
  "FfmpegHwAccel": true,

  // Запасной каскад: локальная VLM смотрит кроп и выбирает номер из кандидатов
  // голосования. Не детектор и не замена Nomeroff: вызывается только если
  // уверенность трека ниже MinConfidence (обычно 5–15% проездов).
  // В одиночку VLM выдумывает правдоподобные номера — поэтому ответ вне формата
  // РФ отбрасывается, а без локальной папки модели арбитр молчит.
  //
  // Включить оба флага:
  //   здесь Enabled=true
  //   и в окружении OCR:  NOMEROFF_VLM=1
  //                       NOMEROFF_VLM_MODEL=D:\models\Qwen2.5-VL-3B-Instruct-AWQ
  // Модель с диска, без скачивания. Рекомендация — Qwen2.5-VL-3B (4bit/AWQ),
  // ~3–4 ГБ VRAM; на 12+ ГБ свободных можно 7B-Instruct 4bit.
  "VlmArbiter": {
    "Enabled": false,
    "MinConfidence": 0.80
  },
  "StorageImage": {
    "MaxWidth": 1920,               // ширина кадра в БД; 0 = без ресайза
    "JpegQuality": 90
  },
  "MaxVideoUploadBytes": 2147483648, // 2 ГБ — лимит загрузки ролика через UI

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Пароль InterBase сюда не пишем (файл уезжает в publish).
  // start-app.bat: Interbase__Password=masterkey, если переменная не задана.
  "Interbase": {
    "DbFolder": "Examples",                 // папка .IBS (рядом с exe / в publish)
    "ArchivePath": "empty38.zip",           // шаблон пустой БД; из него делается yyyy-MM-dd.IBS
    "ConnectionString": "",                 // пусто = собирать строку из полей ниже
    "DefaultDb": "TEST.IBS",                // запасное имя, если дневная БД ещё не выбрана
    "DefaultDeviceId": "",                  // S_DEVICEID, если в запросе не передали
    "GeneratorName": "GEN_SPR_SPEECH_INCKEY",
    "DataSource": "localhost",
    "Port": 3050,
    "User": "SYSDBA",
    "Charset": "WIN1251"
  },

  // OSD регистратора: GPS справа снизу, дата/время слева снизу.
  // В БД: OSD → имя файла → ffprobe creation_time.
  "GpsOcr": {
    "Enabled": true,
    "Engine": "Auto",                 // Auto = Tesseract, при неудаче Python; либо Tesseract | Python
    "CropBottomRatio": 0.10,          // доля высоты кадра снизу под полосу OSD
    "GpsRightWidthRatio": 0.52,       // правая часть полосы — координаты
    "DateTimeLeftWidthRatio": 0.48,   // левая часть полосы — дата/время
    "MinCropHeightPx": 64,            // мин. высота вырезанной полосы до апскейла
    "MinOutputHeightPx": 120,         // до какой высоты растягивать полосу для OCR
    "GpsStripWidthPx": 1800,
    "DateStripWidthPx": 1200,
    "LogOcrTextOnMiss": true,         // писать сырой текст OSD в лог, если разбор не удался
    "TessDataSubdir": "tessdata",
    "PlateCropBottomRatio": 0.12,     // срезать капот+OSD перед OCR номера; 0 = не резать
    "PlateRoiFallback": true,         // нет номеров после обрезки — повторить на зоне дороги
    "EveryNthFrame": 5,               // читать OSD раз в N кадров, между ними интерполяция GPS
    "DateTimeSamples": 3,             // сколько удачных чтений даты достаточно, чтобы зафиксировать якорь
    "DateTimeMaxAttempts": 12         // сколько кадров максимум пробовать, пока якорь не найден
  },

  "FolderWatch": {
    "Enabled": false,                       // автостарт мониторинга при запуске приложения
    "WatchFolder": "D:\\REG_VIDEO",         // папка регистратора
    "AfterAction": "Move",                  // Move | Delete — что делать с роликом после обработки
    "MoveSubfolder": "Processed",
    "SampleFps": 3.0,                       // кадров/с в режиме папки (перекрывает корневой SampleFps)
    "SaveToDb": true,                       // нет .IBS на сегодня — создаётся из empty38.zip
    "DedupIntervalSec": 10,                 // тот же номер в ролике чаще чем раз в N с — одна запись; 0 = выкл
    "PollSeconds": 5,                       // как часто сканировать папку, если нет событий FS
    "StableSeconds": 2,                     // ждать, пока файл перестанет расти (ещё пишется)
    "DiskQueueSubfolder": "_disk_queue"     // отложенные ролики при сбое OCR / InterBase
  }
}
