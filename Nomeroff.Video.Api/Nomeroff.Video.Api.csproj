<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Nomeroff.Video.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <ProjectReference Include="..\Nomeroff.Shared\Nomeroff.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="ffmpeg.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <Content Include="tessdata\eng.traineddata" Condition="Exists('tessdata\eng.traineddata')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="DownloadTessdata" BeforeTargets="Build"
          Condition="!Exists('$(MSBuildProjectDirectory)\tessdata\eng.traineddata')">
    <MakeDir Directories="$(MSBuildProjectDirectory)\tessdata" />
    <Exec IgnoreExitCode="true"
          Command="powershell -NoProfile -Command &quot;Invoke-WebRequest -Uri 'https://github.com/tesseract-ocr/tessdata_fast/raw/main/eng.traineddata' -OutFile '$(MSBuildProjectDirectory)\tessdata\eng.traineddata' -UseBasicParsing&quot;" />
  </Target>
</Project>
